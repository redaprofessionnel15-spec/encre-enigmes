      },
      "transition": "whip"
    },
    {
      "tts": "Parmi eux, les quatre mendiants : figues, amandes, raisins secs et noix. Leurs couleurs rappellent les robes de quatre ordres de moines.",
      "tension": 0.6,
      "scene": {
        "type": "scroll",
        "big": "4 MENDIANTS",
