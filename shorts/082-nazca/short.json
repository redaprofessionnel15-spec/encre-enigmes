      "owl": {
        "x": 230,
        "face": 1,
        "scale": 0.54,
        "mood": "curious"
      },
      "transition": "whip"
    },
    {
      "tts": "Ils ont été tracés il y a environ deux mille ans, par le peuple Nazca.",
      "tension": 0.6,
      "scene": {
        "type": "counter",
        "value": 2000,
        "unit": "ANS",
        "label": "ENVIRON",
        "from": 0,
        "slam_on": "deux"
      },
      "owl": {
        "x": 850,
        "face": -1,
        "scale": 0.54,
        "mood": "serious"
      }
    },
    {
      "tts": "Comment ? En retirant les cailloux sombres, pour laisser apparaître le sol plus clair en dessous.",
      "tension": 0.6,
      "scene": {
        "type": "scroll",
        "big": "DES CAILLOUX",
