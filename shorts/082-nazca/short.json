      },
      "owl": {
        "x": 540,
        "face": 1,
        "scale": 0.56,
        "mood": "surprised"
      }
    },
    {
      "tts": "Ce sont les lignes de Nazca. Un singe, une araignée, un colibri. Certains font des centaines de mètres.",
      "tension": 0.6,
      "scene": {
        "type": "scroll",
        "big": "LIGNES DE NAZCA",
        "line": "un singe, une araignée, un colibri"
