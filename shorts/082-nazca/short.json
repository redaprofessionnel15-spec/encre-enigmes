      "owl": {
        "x": 540,
        "face": 1,
        "scale": 0.56,
        "mood": "curious"
      },
      "transition": "flash"
    },
    {
      "tts": "Et grâce au désert, l'un des plus secs du monde, ils sont restés presque intacts.",
