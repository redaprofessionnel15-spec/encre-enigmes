        "face": 1,
        "scale": 0.56,
        "mood": "curious"
      }
    },
    {
      "tts": "Dans les campagnes de France et d'Europe, on racontait qu'au moment de la messe de minuit, les bœufs et les ânes discutent dans l'étable.",
      "tension": 0.6,
      "scene": {
        "type": "scroll",
        "big": "MINUIT",
