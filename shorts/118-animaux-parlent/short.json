        "mood": "worried"
      },
      "transition": "flash"
    },
    {
      "tts": "Une légende raconte l'histoire d'un fermier qui se cache dans l'étable. Et il entend ses bêtes dire qu'elles porteront bientôt son cercueil.",
      "tension": 0.6,
      "scene": {
        "type": "scroll",
        "big": "SON CERCUEIL",
