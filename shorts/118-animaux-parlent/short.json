      "owl": {
        "x": 230,
        "face": 1,
        "scale": 0.54,
        "mood": "happy"
      },
      "transition": "whip"
    },
    {
      "tts": "Pourquoi eux ? Parce que, selon la tradition, un bœuf et un âne ont réchauffé l'Enfant Jésus dans la crèche.",
      "tension": 0.6,
      "scene": {
        "type": "scroll",
        "big": "LE BŒUF ET L'ÂNE",
        "line": "les témoins de la crèche"
