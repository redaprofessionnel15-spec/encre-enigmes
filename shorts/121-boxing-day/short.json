  "segments": [
    {
      "tts": "Le lendemain de Noël, les Anglais fêtent Boxing Day. Et ça n'a rien à voir avec la boxe.",
      "tension": 0.7,
      "scene": {
        "type": "verdict",
        "claim": "Un jour de boxe ?",
        "stamp": "NON",
        "stamp_on": "boxe"
      },
      "owl": {
        "x": 540,
        "face": 1,
        "scale": 0.56,
        "mood": "smug"
      }
    },
    {
      "tts": "Box, en anglais, ça veut dire boîte. Le jour des boîtes.",
      "tension": 0.6,
      "scene": {
        "type": "quote",
        "title": "BOX = BOÎTE",
        "sign": "— le jour des boîtes"
