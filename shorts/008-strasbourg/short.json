    {"tts": "En juillet quinze cent dix-huit, une femme se met à danser dans une rue de Strasbourg. Et elle ne s'arrête plus.",
     "caption": "En juillet 1518, une femme se met à danser dans une rue de Strasbourg. Et elle ne s'arrête plus.",
     "tension": 0.6, "scene": {"type": "year", "year": 1518, "from": 2026, "place": "STRASBOURG", "land_on": "quinze"},
     "owl": {"x": 540, "face": 1, "scale": 0.56, "mood": "curious", "acts": [{"on": "plus", "pose": "shrug", "mood": "surprised", "hold": 1.0}]}},
    {"tts": "Elle danse pendant près d'une semaine.",
