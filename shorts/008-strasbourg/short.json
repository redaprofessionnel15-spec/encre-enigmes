     "owl": {"x": 230, "face": 1, "scale": 0.54}, "transition": "whip"},
    {"tts": "Puis d'autres la rejoignent. Des dizaines, peut-être des centaines.",
     "tension": 0.7, "scene": {"type": "counter", "value": 400, "unit": "DANSEURS ?", "label": "SELON CERTAINES SOURCES", "from": 0, "slam_on": "centaines"},
     "owl": {"x": 850, "face": -1, "scale": 0.54, "mood": "shocked"}},
    {"tts": "Les médecins ont une idée : les laisser danser jusqu'à ce que ça passe.",
     "tension": 0.5, "scene": {"type": "quote", "title": "AVIS DES MÉDECINS", "sign": "— Strasbourg, 1518"},
     "owl": {"x": 540, "face": 1, "scale": 0.56, "mood": "smug", "acts": [{"on": "passe", "pose": "shrug", "hold": 1.0}]}},
    {"tts": "La ville prépare des salles, et engage même des musiciens.",
     "tension": 0.6, "scene": {"type": "scroll", "big": "MUSIQUE !", "line": "pour guérir les danseurs"},
     "owl": {"x": 230, "face": 1, "scale": 0.54, "mood": "happy"}, "transition": "zoom"},
    {"tts": "Grosse erreur. Il y a encore plus de danseurs. Alors on interdit la musique.",
     "tension": 0.8, "scene": {"type": "verdict", "claim": "La musique, ça marche ?", "stamp": "ÉCHEC", "stamp_on": "erreur"},
     "owl": {"x": 850, "face": -1, "scale": 0.54, "mood": "worried", "acts": [{"on": "interdit", "pose": "cross", "mood": "serious", "hold": 1.0}]}, "transition": "flash"},
    {"tts": "Les danseurs sont emmenés prier dans une chapelle. Et début septembre, tout s'arrête.",
     "tension": 0.5, "scene": {"type": "scroll", "big": "SEPTEMBRE", "line": "fin de l'épidémie"},
     "owl": {"x": 540, "face": 1, "scale": 0.56}},
    {"tts": "Aujourd'hui encore, personne ne sait vraiment pourquoi.",
