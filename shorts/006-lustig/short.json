     "owl": {"x": 850, "face": -1, "scale": 0.54, "acts": [{"on": "file", "pose": "point", "mood": "happy", "hold": 1.0}]}},
    {"tts": "Et Poisson ? Trop honteux, il ne porte même pas plainte.",
