     "owl": {"x": 540, "face": 1, "scale": 0.56}},
    {"tts": "Son annonce : la tour va être démolie. Qui veut acheter la ferraille ?",
     "tension": 0.7, "scene": {"type": "verdict", "claim": "La tour va être démolie ?", "stamp": "FAUX", "stamp_on": "ferraille"},
     "owl": {"x": 230, "face": 1, "scale": 0.54, "mood": "smug"}, "transition": "flash"},
    {"tts": "Un certain André Poisson mord à l'hameçon, et paie. Lustig file avec l'argent.",
