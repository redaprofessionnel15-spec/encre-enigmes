      "owl": {
        "x": 540,
        "face": 1,
        "scale": 0.56,
        "mood": "smug"
      }
    },
    {
      "tts": "Dans les campagnes, la veille de Noël, on choisit une énorme bûche, souvent d'arbre fruitier.",
      "tension": 0.6,
      "scene": {
        "type": "scroll",
        "big": "UNE ÉNORME BÛCHE",
        "line": "choisie pour Noël"
