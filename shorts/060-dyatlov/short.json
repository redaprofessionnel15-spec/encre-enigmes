    {
      "tts": "En 1959, neuf randonneurs fuient leur tente en pleine nuit. Par moins vingt-cinq degrés. Certains pieds nus.",
      "tension": 0.6,
      "scene": {
        "type": "year",
        "year": 1959,
        "from": 2026,
        "place": "OURAL",
        "land_on": "1959"
      },
      "owl": {
        "x": 540,
        "face": 1,
        "scale": 0.56,
        "mood": "worried"
      }
    },
    {
      "tts": "Ce sont des étudiants expérimentés, menés par Igor Dyatlov, dans les montagnes de l'Oural, en Russie.",
      "tension": 0.6,
      "scene": {
        "type": "scroll",
        "big": "IGOR DYATLOV",
        "line": "monts Oural"
      },
      "owl": {
        "x": 230,
        "face": 1,
        "scale": 0.54,
        "mood": "serious"
      },
      "transition": "whip"
    },
    {
      "tts": "Quand les secours arrivent, la tente est vide. Et elle a été découpée… de l'intérieur.",
      "tension": 0.7,
      "scene": {
        "type": "verdict",
        "claim": "Ouverte normalement ?",
        "stamp": "DÉCOUPÉE",
        "stamp_on": "découpée"
      },
      "owl": {
        "x": 850,
        "face": -1,
        "scale": 0.54,
        "mood": "shocked"
      }
    },
    {
      "tts": "Aucun d'eux n'a survécu. Pendant des décennies, on parle d'animaux, d'armes secrètes, et même d'extraterrestres.",
      "tension": 0.6,
      "scene": {
        "type": "scroll",
        "big": "TOUTES LES THÉORIES",
        "line": "pendant 60 ans"
