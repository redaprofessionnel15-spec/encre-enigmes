      "owl": {
        "x": 540,
        "face": 1,
        "scale": 0.56,
        "mood": "sad"
      },
      "transition": "flash"
    },
    {
      "tts": "En 2021, des scientifiques proposent une explication : une petite avalanche de plaque, tombée sur la tente.",
      "tension": 0.6,
      "scene": {
        "type": "scroll",
        "big": "UNE AVALANCHE",
        "line": "selon une étude de 2021"
