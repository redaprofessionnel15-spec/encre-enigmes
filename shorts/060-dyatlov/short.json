      "owl": {
        "x": 230,
        "face": 1,
        "scale": 0.54,
        "mood": "curious"
      }
    },
    {
      "tts": "Une explication solide. Mais certains détails restent troublants, et l'affaire divise encore.",
      "tension": 0.7,
      "scene": {
        "type": "verdict",
        "claim": "Résolu ?",
