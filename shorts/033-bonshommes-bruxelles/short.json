        "scale": 0.54,
        "mood": "worried"
      },
      "transition": "whip"
    },
    {
      "tts": "Alors, les habitants sortent, et transforment toute la ville en musée de neige.",
      "tension": 0.6,
      "scene": {
        "type": "scroll",
        "big": "UN MUSÉE DE NEIGE",
