        "face": 1,
        "scale": 0.56,
        "mood": "smug"
      }
    },
    {
      "tts": "Cet hiver-là, il fait si froid qu'on l'appelle l'hiver de la mort. Il gèle pendant des semaines.",
      "tension": 0.6,
      "scene": {
        "type": "scroll",
        "big": "HIVER DE LA MORT",
