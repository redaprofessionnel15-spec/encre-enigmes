      "owl": {
        "x": 850,
        "face": -1,
        "scale": 0.54,
        "mood": "surprised"
      }
    },
    {
      "tts": "On imagine des avions qui tombent, des banques qui bloquent, des centrales en panne. Certains font même des réserves de nourriture.",
      "tension": 0.6,
      "scene": {
        "type": "scroll",
        "big": "DES RÉSERVES",
