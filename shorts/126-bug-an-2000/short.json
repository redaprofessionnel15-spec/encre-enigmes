      "owl": {
        "x": 540,
        "face": 1,
        "scale": 0.56,
        "mood": "worried"
      }
    },
    {
      "tts": "Le problème : pour gagner de la place, beaucoup d'ordinateurs ne notaient l'année qu'avec deux chiffres. 99 pour 1999.",
      "tension": 0.6,
      "scene": {
        "type": "scroll",
        "big": "99 = 1999",
        "line": "deux chiffres seulement"
