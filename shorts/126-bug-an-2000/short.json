        "face": 1,
        "scale": 0.54,
        "mood": "curious"
      },
      "transition": "whip"
    },
    {
      "tts": "Alors à minuit, 99 devient 00. Et l'ordinateur risque de croire qu'on est revenu en 1900.",
      "tension": 0.6,
      "scene": {
        "type": "year",
        "year": 1900,
